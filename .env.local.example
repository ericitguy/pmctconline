# Copy to .env.local for local dev, or set these in Vercel
# (Settings → Environment Variables). Never commit real values.

# --- Enquiry email delivery (activates the staff notification) ---
# Create at resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Where notifications are delivered — PMCTC staff inboxes, comma separated
ENQUIRY_EMAIL_TO=sika.addo@yahoo.com,asabea8394@gmail.com

# Verified sending identity. Before pmctconline.com DNS is verified with
# Resend, keep the default onboarding@resend.dev (works with restrictions —
# test sends only go to the account owner's inbox). After DNS verification
# switch to:
# ENQUIRY_EMAIL_FROM=PMCTC Website <enquiries@pmctconline.com>
ENQUIRY_EMAIL_FROM=PMCTC Website <onboarding@resend.dev>
